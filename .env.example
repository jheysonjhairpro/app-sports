NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (MySQL) ---
DATABASE_URL="mysql://root:XXXXX@localhost:3306/abanplay"

# --- Autenticación ---
JWT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_EXPIRES=59m
JWT_REFRESH_DAYS=30

# --- Reglas de negocio ---
MAX_HORAS_RESERVA=4
MINUTOS_PAGO=30
CANCELACION_MIN_HORAS=2

RUN_CRONS=true

# --- Cloudinary 
CLOUDINARY_CLOUD_NAME=XXXXXXXX
CLOUDINARY_API_KEY=XXXXXXXXXXXXXXXX
CLOUDINARY_API_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Correo (SMTP). Si SMTP_HOST está vacío
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=XXXXXXXXXXXXXXXXXXXXXXXXXX
SMTP_PASS=XXXXXXXXXXXXXXXXXX
MAIL_FROM="AbanPlay <abanplay.notificaciones@gmail.com>"

# --- Seed: primer super admin ---
SUPERADMIN_EMAIL=superadmin@abanplay.com
SUPERADMIN_PASSWORD=12121212